{
  "name": "yingji",
  "version": "3.0.0",
  "description": "映迹 Flutter Windows 私人媒体客户端（内置 libmpv）",
  "main": "main.cjs",
  "author": "Yingji",
  "license": "UNLICENSED",
  "scripts": {
    "start": "flutter run -d windows",
    "build:windows": "flutter build windows --release",
    "package:installer": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "test": "flutter test",
    "analyze": "flutter analyze"
  },
  "devDependencies": {
    "electron": "39.2.7",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.yingji.desktop",
    "productName": "映迹",
    "artifactName": "Yingji-${version}-Windows-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "THIRD_PARTY_NOTICES.md",
      "app/**/*"
    ],
    "asarUnpack": [
      "app/mpv/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "appx"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "appx": {
      "applicationId": "Yingji",
      "displayName": "映迹",
      "publisherDisplayName": "Yingji",
      "identityName": "Yingji.Desktop",
      "publisher": "CN=Yingji"
    }
  }
}
