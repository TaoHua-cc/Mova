<?xml version="1.0" encoding="utf-8"?>
<!--
  User-added Emby/Jellyfin/WebDAV media servers can use HTTP at arbitrary
  hosts, including redirect destinations. Android domain entries are not IP
  subnet rules, and cannot be updated for runtime-added servers.
  Permit HTTP for compatibility; HTTP is unencrypted. Built-in services keep
  their HTTPS URLs and TLS certificate validation remains enabled.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>

</network-security-config>
